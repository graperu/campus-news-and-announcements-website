{
  "name": "campus-news",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=config/local.env --watch backend/server.mjs",
    "start": "node --env-file-if-exists=config/local.env backend/server.mjs",
    "user:create": "node --env-file-if-exists=config/local.env scripts/users/create-user.mjs",
    "import:uth": "node --env-file-if-exists=config/local.env scripts/data/import-uth.mjs",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "check": "node --check backend/server.mjs && node --check api/index.mjs && node --check frontend/js/app.js && node --check frontend/js/motion.js",
    "data:restore": "node --env-file-if-exists=config/local.env scripts/data/restore-source.mjs",
    "test:browser": "node scripts/checks/browser-check.mjs",
    "test:cache": "node scripts/metrics/measure-cache.mjs",
    "test:freshness": "node scripts/metrics/measure-freshness.mjs",
    "test:workflow": "node tests/workflow.e2e.mjs",
    "format": "prettier --ignore-path config/prettier.ignore --write api vercel.json config backend frontend scripts tests docs .github package.json README.md database/README.md storage/README.md",
    "format:check": "prettier --ignore-path config/prettier.ignore --check api vercel.json config backend frontend scripts tests docs .github package.json README.md database/README.md storage/README.md",
    "test:ui": "node scripts/checks/check-ui-refinements.mjs",
    "test:ui:upgrade": "node scripts/checks/check-ui-upgrade.mjs",
    "test:ui:audit": "node scripts/checks/check-ui-audit-fixes.mjs",
    "test:ui:motion": "node scripts/checks/check-ui-motion.mjs",
    "test:deployment": "node scripts/checks/check-public-deployment.mjs",
    "test:news": "node scripts/checks/check-news-content.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.1169.0",
    "@aws-sdk/client-s3": "^3.0.0",
    "jose": "^6.0.0",
    "pg": "^8.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "prettier": "^3.10.1"
  },
  "prettier": "./config/prettier.json"
}
