{
  "name": "campus-news",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch backend/server.mjs",
    "start": "node --env-file-if-exists=.env backend/server.mjs",
    "user:create": "node scripts/create-user.mjs",
    "import:uth": "node scripts/import-uth.mjs",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "check": "node --check backend/server.mjs && node --check frontend/app.js",
    "data:restore": "node scripts/restore-source.mjs",
    "test:browser": "node scripts/browser-check.mjs",
    "test:cache": "node scripts/measure-cache.mjs",
    "test:freshness": "node scripts/measure-freshness.mjs",
    "test:workflow": "node tests/workflow.e2e.mjs",
    "format": "prettier --write backend frontend scripts tests docs .github package.json README.md database/README.md",
    "format:check": "prettier --check backend frontend scripts tests docs .github package.json README.md database/README.md"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.1169.0",
    "@aws-sdk/client-s3": "^3.0.0",
    "jose": "^6.0.0",
    "pg": "^8.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "prettier": "^3.10.1"
  }
}
